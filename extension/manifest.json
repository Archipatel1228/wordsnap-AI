{
  "manifest_version": 3,
  "name": "WordSnap AI — Instant Word Meanings",
  "version": "1.0.0",
  "description": "Highlight any word on any site to get its meaning, pronunciation and an AI explanation — and save it to your WordSnap vocabulary.",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://wordsnap.lovable.app/*",
    "https://dgdrrueqkyosmbwbtghe.supabase.co/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WordSnap AI",
    "default_icon": { "48": "icons/icon-192.png", "128": "icons/icon-512.png" }
  },
  "options_page": "options.html",
  "icons": { "192": "icons/icon-192.png", "512": "icons/icon-512.png" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["https://wordsnap.lovable.app/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://wordsnap.lovable.app/*"],
      "js": ["auth-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-192.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
