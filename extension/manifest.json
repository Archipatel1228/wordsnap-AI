{
  "manifest_version": 3,
  "name": "WordSnap AI \u2014 Instant Word Meanings",
  "version": "1.0.0",
  "description": "Highlight any word on any site to get its meaning, pronunciation and an AI explanation \u2014 and save it to your WordSnap vocabulary.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://wordsnap.lovable.app/api/public/lookup",
    "https://dgdrrueqkyosmbwbtghe.supabase.co/rest/v1/*",
    "https://dgdrrueqkyosmbwbtghe.supabase.co/auth/v1/token*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WordSnap AI",
    "default_icon": {
      "48": "icons/icon-192.png",
      "128": "icons/icon-512.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "192": "icons/icon-192.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "exclude_matches": [
        "https://wordsnap.lovable.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://wordsnap.lovable.app/*"
      ],
      "js": [
        "auth-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-192.png"
      ],
      "matches": [
        "https://*/*"
      ]
    }
  ]
}
